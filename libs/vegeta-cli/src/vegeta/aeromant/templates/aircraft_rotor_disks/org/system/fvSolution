/*--------------------------------*- C++ -*----------------------------------*\
  Aeromant template case (OpenFOAM.org dialect) — placeholder values are inserted by aeromant.prepare()
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-7;
        relTol          0.05;
    }

    "(U|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
    }
}

SIMPLE
{
    // rotor-disk sources at a low free stream (near the hover) are strong momentum sources: plain SIMPLE with the
    // under-relaxation of OpenFOAM's rotorDisk tutorial, not SIMPLEC (which diverged on blown tailsitter cases)
    nNonOrthogonalCorrectors 1;
    consistent      no;
    residualControl
    {
        p               {{RESIDUAL_TARGET}};
        "(U|k|omega)"     {{RESIDUAL_TARGET}};
    }
}

relaxationFactors
{
    fields
    {
        p               0.3;
    }
    equations
    {
        U               0.7;
        "(k|omega)"     0.7;
    }
}

// ************************************************************************* //
