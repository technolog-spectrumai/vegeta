/*--------------------------------*- C++ -*----------------------------------*\
  Aeromant template case — values in {{...}} are inserted by aeromant.prepare()
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    body.stl
    {
        type triSurfaceMesh;
        name body;
    }
    disk1
    {
        type searchableCylinder;
        point1 ({{DISK1_P1}});
        point2 ({{DISK1_P2}});
        radius {{DISK_ZONE_RADIUS}};
    }
    disk2
    {
        type searchableCylinder;
        point1 ({{DISK2_P1}});
        point2 ({{DISK2_P2}});
        radius {{DISK_ZONE_RADIUS}};
    }
    disk3
    {
        type searchableCylinder;
        point1 ({{DISK3_P1}});
        point2 ({{DISK3_P2}});
        radius {{DISK_ZONE_RADIUS}};
    }
    disk4
    {
        type searchableCylinder;
        point1 ({{DISK4_P1}});
        point2 ({{DISK4_P2}});
        radius {{DISK_ZONE_RADIUS}};
    }
    nearBox
    {
        type searchableBox;
        min ({{NEAR_MIN}});
        max ({{NEAR_MAX}});
    }
    wakeBox
    {
        type searchableBox;
        min ({{WAKE_MIN}});
        max ({{WAKE_MAX}});
    }
}

castellatedMeshControls
{
    maxLocalCells           2000000;
    maxGlobalCells          8000000;
    minRefinementCells      0;
    maxLoadUnbalance        0.10;
    nCellsBetweenLevels     3;

    features
    (
        {
            file "body.eMesh";
            level {{FEATURE_LEVEL}};
        }
    );

    refinementSurfaces
    {
        body
        {
            level ({{SURFACE_LEVEL_MIN}} {{SURFACE_LEVEL_MAX}});
            patchInfo
            {
                type wall;
            }
        }
        disk1
        {
            level (0 0);
            faceZone disk1;
            cellZone disk1;
            cellZoneInside inside;
        }
        disk2
        {
            level (0 0);
            faceZone disk2;
            cellZone disk2;
            cellZoneInside inside;
        }
        disk3
        {
            level (0 0);
            faceZone disk3;
            cellZone disk3;
            cellZoneInside inside;
        }
        disk4
        {
            level (0 0);
            faceZone disk4;
            cellZone disk4;
            cellZoneInside inside;
        }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
        disk1
        {
            mode inside;
            levels ((1E15 {{DISK_LEVEL}}));
        }
        disk2
        {
            mode inside;
            levels ((1E15 {{DISK_LEVEL}}));
        }
        disk3
        {
            mode inside;
            levels ((1E15 {{DISK_LEVEL}}));
        }
        disk4
        {
            mode inside;
            levels ((1E15 {{DISK_LEVEL}}));
        }
        wakeBox
        {
            mode inside;
            levels ((1E15 {{WAKE_LEVEL}}));
        }
        nearBox
        {
            mode inside;
            levels ((1E15 {{NEAR_LEVEL}}));
        }
    }

    locationInMesh ({{LOCATION_IN_MESH}});
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch            3;
    tolerance               2.0;
    nSolveIter              50;
    nRelaxIter              5;
    nFeatureSnapIter        10;
    implicitFeatureSnap     false;
    explicitFeatureSnap     true;
    multiRegionFeatureSnap  false;
}

addLayersControls
{
    relativeSizes           true;
    layers
    {
    }
    expansionRatio          1.2;
    finalLayerThickness     0.5;
    minThickness            0.1;
    nGrow                   0;
    featureAngle            60;
    nRelaxIter              5;
    nSmoothSurfaceNormals   1;
    nSmoothNormals          3;
    nSmoothThickness        10;
    maxFaceThicknessRatio   0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle      90;
    nBufferCellsNoExtrude   0;
    nLayerIter              50;
}

meshQualityControls
{
    maxNonOrtho             65;
    maxBoundarySkewness     20;
    maxInternalSkewness     4;
    maxConcave              80;
    minVol                  1e-13;
    minTetQuality           1e-15;
    minArea                 -1;
    minTwist                0.02;
    minDeterminant          0.001;
    minFaceWeight           0.05;
    minVolRatio             0.01;
    minTriangleTwist        -1;
    nSmoothScale            4;
    errorReduction          0.75;
    relaxed
    {
        maxNonOrtho         75;
    }
}

mergeTolerance 1e-6;

// ************************************************************************* //
