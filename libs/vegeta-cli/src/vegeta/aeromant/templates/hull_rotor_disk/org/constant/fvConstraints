/*--------------------------------*- C++ -*----------------------------------*\
  Aeromant template case — values in {{...}} are inserted by aeromant.prepare()
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvConstraints;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// a divergence guard, not a model: |U| is capped well above any physical speed in the case (the blade tip speed is the
// most a rotor disk can give the air), so a diverging iteration is clamped instead of overflowing to 1e300
limitU
{
    type            limitVelocity;
    selectionMode   all;
    max             {{U_LIMIT}};
}

// ************************************************************************* //
