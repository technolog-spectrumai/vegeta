/*--------------------------------*- C++ -*----------------------------------*\
  Aeromant template case — values in {{...}} are inserted by aeromant.prepare()
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform {{OMEGA_INLET}};

boundaryField
{
    ground
    {
        type            omegaWallFunction;
        value           uniform {{OMEGA_INLET}};
    }
    floor
    {
        type            omegaWallFunction;
        value           uniform {{OMEGA_INLET}};
    }
    suction
    {
        type            inletOutlet;
        inletValue      uniform {{OMEGA_INLET}};
        value           uniform {{OMEGA_INLET}};
    }
    sides
    {
        type            inletOutlet;
        inletValue      uniform {{OMEGA_INLET}};
        value           uniform {{OMEGA_INLET}};
    }
    "body.*"
    {
        type            omegaWallFunction;
        value           uniform {{OMEGA_INLET}};
    }
}

// ************************************************************************* //
