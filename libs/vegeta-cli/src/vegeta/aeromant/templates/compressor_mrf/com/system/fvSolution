/*--------------------------------*- C++ -*----------------------------------*\
  Aeromant template case — values in {{...}} are inserted by aeromant.prepare()
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-7;
        relTol          0.05;
    }
    "(U|h|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 1;
    consistent      no;
    transonic       {{TRANSONIC}};
    pMinFactor      0.3;
    pMaxFactor      3.0;

    residualControl
    {
        p               {{RESIDUAL_TARGET}};
        "(U|h|k|omega)"   {{RESIDUAL_TARGET}};
    }
}

relaxationFactors
{
    fields
    {
        p               0.2;
        rho             0.05;
    }
    equations
    {
        U               0.5;
        h               0.5;
        ".*"            0.6;
    }
}

// ************************************************************************* //
