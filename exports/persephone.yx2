    def Scope "joints"
    {
        def PhysicsFixedJoint "segment_1_weld"
        {
            rel physics:body0 = </persephone/head>
            rel physics:body1 = </persephone/segment_1>
            point3f physics:localPos0 = (-0.08, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            custom double3 yax:axis = (1, 0, 0)
            custom token yax:kind = "fixed"
            custom string yax:name = "segment 1_weld"
            custom double3 yax:pos = (-0.08, 0, 0)
            custom string yx2:id = "joint:segment 1_weld"
        }

        def PhysicsRevoluteJoint "s1_front_left_hip_yaw" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.3
            float drive:angular:physics:stiffness = 1
            uniform token physics:axis = "X"
            rel physics:body0 = </persephone/segment_1>
            rel physics:body1 = </persephone/s1_front_left_femur__s1_front_left_hip_yaw>
            point3f physics:localPos0 = (0.015, 0.028, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, 0.70710677, 0)
            quatf physics:localRot1 = (0.70710677, 0, 0.70710677, 0)
            float physics:lowerLimit = -60
