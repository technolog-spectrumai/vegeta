{
    custom string yax:data = "{\"ketos\":{\"card\":{\"autonomous\":true,\"autonomy\":{\"ais\":\"class A transponder: the others see it, it sees them\",\"colregs\":\"COLREGs rules 8-17 in the autopilot: give way / stand on, a closest-approach limit of 0.3 nm\",\"comms\":\"LEO satcom + 4G/LTE + UHF to shore; 900 MHz + LTE to the drones; ADS-B in\",\"gnss_ins\":\"dual RTK GNSS + fibre-optic INS: DP over the bed, the pads' motion for the drones\",\"lidar_cameras\":\"360 deg lidar ring, day and IR cameras: small craft, buoys, swimmers, the drones on deck\",\"radar\":\"X- and S-band ARPA: targets out to 12 nm, the collision avoidance's tracks\",\"supervision\":\"one shore operator per 3 vessels: alarms, a remote takeover (teleop) when a fault asks\"},\"basket_robot\":true,\"battery_kWh\":350.0,\"bed_load_kW\":82.0,\"carries\":[\"walrus\",\"gannet\",\"fulmar\"],\"crew\":0,\"davit\":{\"boom_m\":2.4,\"compensated\":true,\"compensation_eur\":28500.0,\"hs_limit_m\":2.8,\"hs_limit_uncompensated_m\":2.0,\"limited_by\":\"luff_stroke\",\"luff\":{\"peak_kW\":1.5,\"price_eur\":4500.0,\"range_deg\":[5.0,85.0],\"rate_deg_s\":40.0,\"speed_m_s\":0.3,\"stroke_m\":0.55,\"what\":\"luffing ball-screw cylinder (boom angle from the vertical)\"},\"max_heave_m\":2.1,\"max_pitch_deg\":5.0,\"max_roll_deg\":10.5,\"mechanism\":\"MRU + AHC winch + compensating luff and slew\",\"mru\":{\"heave_accuracy_frac\":0.05,\"heave_accuracy_m\":0.05,\"latency_s\":0.01,\"power_W\":15.0,\"price_eur\":7000.0,\"rate_hz\":100.0,\"roll_pitch_accuracy_deg\":0.02,\"what\":\"6-DOF motion reference unit (MEMS gyros + accelerometers, heave filter), on the davit's base\"},\"payload_kg\":60.0,\"peak_kW\":6.5,\"power_kW_avg\":2.5,\"residual_at_2m_m\":{\"horizontal\":0.059,\"vertical\":0.125},\"residual_at_limit_m\":{\"horizontal\":0.082,\"vertical\":0.167},\"sheave_motion_at_limit_m\":2.59,\"slew\":{\"peak_kW\":1.0,\"price_eur\":3500.0,\"range_deg\":[-35.0,35.0],\"rate_deg_s\":30.0,\"what\":\"worm slewing drive under the post\"},\"supercaps\":{\"kJ\":60.0,\"price_eur\":1500.0,\"what\":\"supercapacitor bank on the davit's DC bus (the peaks, the regenerated energy)\"},\"uprated_winch\":{\"extra_eur\":6000.0,\"hs_limit_m\":2.8,\"line_pull_N\":3000.0,\"payload_kg\":150.0,\"peak_kW\":9.0,\"what\":\"uprated AHC winch: 3 kN line pull, the same rope speed\"},\"winch\":{\"line_pull_N\":1200.0,\"peak_kW\":4.0,\"price_eur\":9000.0,\"rope_accel_m_s2\":3.0,\"rope_m\":40.0,\"rope_speed_m_s\":2.5,\"what\":\"AHC winch: a servo motor on the drum, 4-quadrant drive, regenerating\"}},\"davit_hs_limit_m\":2.8,\"davits\":4,\"day_rate_eur\":1400.0,\"displacement_t\":108.0,\"draught_m\":1.5,\"endurance_days\":15.6,\"flight_deck\":{\"catapult\":{\"at\":[-0.2,0.0],\"cycle_s\":240.0,\"stroke_m\":7.0},\"charger_kW\":1.33,\"chargers\":12,\"crate_load_s\":40.0,\"deck_hs_limit_m\":2.0,\"hangar\":{\"fulmar\":3,\"gannet\":8},\"land_lock_s\":40.0,\"launch_s\":30.0,\"net\":{\"at\":[-9.1,0.0],\"cycle_s\":300.0,\"size_m\":[6.0,4.0]},\"packs\":{\"fulmar\":9,\"gannet\":24},\"pad_cycle_s\":170.0,\"pads\":[[-6.2,2.4],[-6.2,-2.4],[-2.6,2.4],[-2.6,-2.4]],\"swap_s\":90.0,\"z_m\":5.85},\"fuel_l_h_on_bed\":28.7,\"haul_min_per_basket\":1.5,\"hold_kg\":2000.0,\"kind\":\"boat\",\"loads_kW\":{\"4 Walruses on their tethers\":1.98,\"DP (two pods, a tunnel, 0.5 m/s tide, 8 m/s wind)\":45.0,\"autonomy: radars, lidar, cameras, compute, comms\":2.5,\"basket robot\":1.5,\"chiller + ice\":5.0,\"davits + reels (average)\":2.0,\"drone chargers (12 at 1C)\":16.0,\"hotel\":2.0,\"processing line + vision grader\":6.0},\"mass_kg\":96750,\"max_kn\":14.6,\"name\":\"zarco\",\"operators_ashore\":0.333,\"packing\":{\"crate_kg\":5.0,\"ice\":true,\"pack_s\":60.0,\"store_kg\":2000.0},\"parts\":[{\"color\":[0.204,0.286,0.369],\"model\":\"zarco_hulls\"},{\"color\":[0.584,0.647,0.651],\"model\":\"zarco_deck\"},{\"color\":[0.925,0.941,0.945],\"model\":\"zarco_house\"},{\"color\":[0.498,0.549,0.553],\"model\":\"zarco_flight_deck\"},{\"color\":[0.945,0.769,0.059],\"model\":\"zarco_pads\"},{\"color\":[0.753,0.224,0.169],\"model\":\"zarco_catapult\"},{\"color\":[0.173,0.243,0.314],\"model\":\"zarco_net\"},{\"color\":[0.816,0.827,0.831],\"model\":\"zarco_mast\"},{\"color\":[0.902,0.494,0.133],\"model\":\"zarco_davits\"},{\"color\":[0.153,0.682,0.376],\"model\":\"zarco_robots\"}],\"power_W\":82000,\"price_eur\":4153780,\"rates\":{\"baskets_per_h\":40,\"crates_per_h\":60,\"fixed_wing_launches_per_h\":15.0,\"fixed_wing_recoveries_per_h\":12.0,\"pack_kg_h\":300,\"vtol_launches_per_h\":240.0,\"vtol_recoveries_per_h\":84.7},\"robots\":{\"basket_gantry\":{\"count\":1,\"cycle_s\":90.0,\"faults_per_day\":0.3,\"fix_min\":8.0,\"payload_kg\":40.0,\"power_kW\":1.5,\"price_eur\":85000.0,\"reach_m\":9.0,\"what\":\"a gantry over the Walrus deck: grabs the float line, winches the basket, tips it onto the wash conveyor, sends it back down\"},\"cleaner\":{\"count\":1,\"cycle_s\":1800.0,\"faults_per_day\":0.05,\"fix_min\":15.0,\"payload_kg\":5.0,\"power_kW\":0.4,\"price_eur\":30000.0,\"reach_m\":0.0,\"what\":\"a magnetic crawler: washes the pads' grids, the deck, the radar and camera windows; inspects welds and the net\"},\"crate_loader\":{\"count\":1,\"cycle_s\":40.0,\"faults_per_day\":0.3,\"fix_min\":6.0,\"payload_kg\":8.0,\"power_kW\":1.0,\"price_eur\":70000.0,\"reach_m\":12.0,\"what\":\"an arm on a rail along the flight deck and down the lift: a crate from the store to a Gannet's hook or a Fulmar's pod\"},\"davit\":{\"count\":4,\"cycle_s\":300.0,\"faults_per_day\":0.08,\"fix_min\":10.0,\"payload_kg\":60.0,\"power_kW\":2.5,\"price_eur\":66500.0,\"reach_m\":2.4,\"what\":\"a motion-compensated davit with a latch cradle (``DAVIT_AHC``): an MRU on its base, an active-heave-compensated winch, a compensating luff and slew - the hook stands still in the earth frame while the deck moves; a Walrus over the side and back, the tether reel paced to it\"},\"deck_tug\":{\"count\":1,\"cycle_s\":60.0,\"faults_per_day\":0.1,\"fix_min\":10.0,\"payload_kg\":30.0,\"power_kW\":0.8,\"price_eur\":45000.0,\"reach_m\":14.0,\"what\":\"a low tug with a gripper: drones between the pads, the lift and the catapult cradle; a Fulmar out of the net\"},\"packing_cell\":{\"count\":1,\"cycle_s\":60.0,\"faults_per_day\":0.4,\"fix_min\":6.0,\"payload_kg\":10.0,\"power_kW\":6.0,\"price_eur\":160000.0,\"reach_m\":1.6,\"what\":\"wash, vision grader, a 6-axis arm: clams and flake ice into a 5 kg crate, lid, label (harvest time, cell)\"},\"swap_robot\":{\"count\":1,\"cycle_s\":90.0,\"faults_per_day\":0.3,\"fix_min\":8.0,\"payload_kg\":8.0,\"power_kW\":1.0,\"price_eur\":90000.0,\"reach_m\":12.0,\"what\":\"a gantry between the pads and the battery room: the pack out of a locked drone's sled, a charged one in\"}},\"schema\":\"ketos.card\",\"service_kW\":170,\"service_kn\":10.0,\"size\":[24.0,10.0,11.0],\"tether_reels\":4,\"unmanned\":true,\"usbl\":true,\"version\":\"1.0\"},\"meshes\":[\"zarco_hulls\",\"zarco_deck\",\"zarco_house\",\"zarco_flight_deck\",\"zarco_pads\",\"zarco_catapult\",\"zarco_net\",\"zarco_mast\",\"zarco_davits\",\"zarco_robots\"],\"source\":\"exports/ketos/zarco.card.json\"},\"provenance\":{\"notes\":\"Zarco (formerly Pinna), the unmanned drone-carrier catamaran, loaded on the clam bed: a rigid body\",\"robot\":\"Zarco\",\"sources\":{\"centres\":\"esmeralda.ZARCO_CENTRES (class estimates)\",\"looks\":\"designs/zarco.py:Zarco\",\"masses\":\"zarco.LIGHTSHIP, zarco.DEADWEIGHT (class values)\"}}}"
