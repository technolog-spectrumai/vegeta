    def Xform "pelvis" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (0.0049252124, 0.009251513, 0.010731562)
        float physics:mass = 4.70775
        quatf physics:principalAxes = (0.70710677, -7.669909e-15, -6.0520525e-15, 0.70710677)
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        custom double3 yax:com = (0, 0, 0)
        custom string yax:data = '{"free_joint":"pelvis:free"}'
        custom double[] yax:inertia = [0.00925151250000005, 2.4650981256257935e-17, -2.859462666648945e-17, 2.465098125625793e-17, 0.004925212500000026, 1.3123402364811944e-17, -2.859462666648945e-17, 1.3123402364811944e-17, 0.010731562500000055]
        custom double yax:mass = 4.70775
        custom string yax:name = "pelvis"
        custom double3 yax:pos = (0, 0, 0)
        custom double4 yax:quat = (1, 0, 0, 0)
        custom string yx2:id = "link:pelvis"

        def Cube "pelvis_shell" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.81, 0.84, 0.87)]
            float[] primvars:displayOpacity = [1]
            double size = 1
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:scale = (0.15, 0.23, 0.11)
