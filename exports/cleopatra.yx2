,\"no_load_speed_rpm\":100.0,\"rated_torque_nm\":0.14,\"source\":\"generic 13 g servo datasheet\",\"stall_current_a\":1.1,\"stall_torque_nm\":0.32,\"voltage_v\":7.4},\"micro-metal 20 g\":{\"kind\":\"servo\",\"mass_kg\":0.02,\"name\":\"micro-metal 20 g\",\"no_load_speed_rpm\":90.0,\"rated_torque_nm\":0.22,\"source\":\"generic 20 g metal-gear servo datasheet\",\"stall_current_a\":1.4,\"stall_torque_nm\":0.55,\"voltage_v\":7.4},\"micro-metal 22 g worm\":{\"kind\":\"servo\",\"mass_kg\":0.022,\"name\":\"micro-metal 22 g worm\",\"no_load_speed_rpm\":45.0,\"rated_torque_nm\":0.22,\"source\":\"assumed: a 20 g servo with a worm output stage (self-locking, slower)\",\"stall_current_a\":1.4,\"stall_torque_nm\":0.5,\"transmission\":{\"self_locking\":true,\"source\":\"ogma.actuators: as the catalogue entry states it\"},\"voltage_v\":7.4},\"smart servo 6 Nm\":{\"kind\":\"smart servo\",\"mass_kg\":0.07,\"name\":\"smart servo 6 Nm\",\"no_load_speed_rpm\":55.0,\"rated_torque_nm\":2.0,\"source\":\"serial-bus smart servo class, supplier datasheet\",\"stall_current_a\":3.0,\"stall_torque_nm\":6.0,\"voltage_v\":12.0}},\"provenance\":{\"notes\":\"Cleopatra, treatment 'spring_damper': passive hinges yaw -> pitch -> roll at body joints 1-2 and 2-3 (yaw: k 8 N\\u00b7m/rad, c 0.2 N\\u00b7m\\u00b7s/rad, q0 0 rad, limits [-0.785398, 0.785398] rad; pitch: k 8 N\\u00b7m/rad, c 0.2 N\\u00b7m\\u00b7s/rad, q0 0 rad, limits [-0.785398, 0.785398] rad; roll: k 8 N\\u00b7m/rad, c 0.2 N\\u00b7m\\u00b7s/rad, q0 0 rad, limits [-0.349066, 0.349066] rad); armature 0, friction loss 0, no body actuator, translations constrained; leg servo armature 0.0 kg\\u00b7m\\u00b2; params {'seg_length': 0.15, 'seg_width': 0.11, 'seg_height': 0.07, 'shell_thickness': 0.003, 'joint_gap': 0.02, 'head_length': 0.13, 'head_taper': 0.85, 'femur': 0.06, 'tibia': 0.075, 'leg_diameter': 0.016, 'tibia_diameter_ratio': 0.8, 'foot_diameter': 0.024, 'leg_pair_spacing': 0.5, 'hip_y_offset': 0.006, 'hip_angle_deg': 40.0, 'knee_angle_deg': 85.0, 'shell_mass': 0.2592, 'leg_cad_mass': 0.14752500000000004, 'pad_mass': 0.01, 'leg_servo': 'smart servo 6 Nm', 'body_servo': 'smart servo 12 Nm', 'body_servos_per_segment': 2, 'pcb_mass': 0.06, 'wiring_mass': 0.05, 'head_shell_mass': 0.188, 'head_payload': (('4K day camera', 0.18), ('NIR night camera', 0.12), ('LWIR', 0.09), ('microphones, IMU, radio', 0.06), ('sensor turret (camera + lidar)', 0.1)), 'battery_mass': 0.444, 'compute_mass': 0.15, 'camera_x': 0.04, 'body_servo_x': 0.05, 'battery_z': -0.015, 'compute_z': 0.01, 'pcb_z': 0.025, 'foot_mu': 0.8, 'shell_mu': 0.5}\",\"robot\":\"cleopatra v2 spring_damper\",\"sources\":{\"body connection\":\"protocol \\u00a712.1 (Amendment D, 2026-10-01): identical passive hinges (pitch, yaw, roll configurable), defaults k 8 N\\u00b7m/rad, c 0.2 N\\u00b7m\\u00b7s/rad (spring_damper; 0 in spring), q0 0 rad, limits \\u00b145\\u00b0 pitch and yaw, \\u00b120\\u00b0 roll\",\"friction\":\"protocol \\u00a71: pads 0.8 (rubber on rock), shells and head 0.5\",\"geometry\":\"designs/myropod.py with notebook 18's CLEO parameters (CLEO_MM); protocol \\u00a71\",\"leg servo\":\"actuators.py 'smart servo 6 Nm': serial-bus smart servo class, supplier datasheet; kp 40.0, kd 0.8 (protocol \\u00a71)\",\"masses\":\"notebook 18 mass budget (CAD volume x 1.1 g/cm^3, actuators.py servo masses, recorded payload); protocol \\u00a71 table\",\"placement\":\"CleopatraParams docstring (thin-walled shells, payload positions)\"}}}"
