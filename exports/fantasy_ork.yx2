    def Scope "joints"
    {
        def PhysicsRevoluteJoint "waist_yaw" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 3
            float drive:angular:physics:stiffness = 1
            uniform token physics:axis = "X"
            rel physics:body0 = </fantasy_ork/pelvis>
            rel physics:body1 = </fantasy_ork/torso>
            point3f physics:localPos0 = (0, 0, 0.07)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, -0.70710677, 0)
            quatf physics:localRot1 = (0.70710677, 0, -0.70710677, 0)
            float physics:lowerLimit = -68.75494
