    def Xform "head" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0.0074380166, 0, 0)
        float3 physics:diagonalInertia = (0.001999608, 0.0037188262, 0.0037450038)
        float physics:mass = 2.42
        quatf physics:principalAxes = (1.6209256e-14, 1, -1.10011e-28, 6.5773277e-15)
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        custom double3 yax:com = (0.007438016529171505, 0, 0)
        custom string yax:data = '{"free_joint":"head:free"}'
        custom double[] yax:inertia = [0.0019996080321538377, 0, -2.2960081500438348e-17, 0, 0.003718826223712318, 0, -2.296008150043835e-17, 0, 0.0037450038839445397]
        custom double yax:mass = 2.41999999992
        custom string yax:name = "head"
        custom double3 yax:pos = (0, 0, 0)
        custom double4 yax:quat = (1, 0, 0, 0)
        custom string yx2:id = "link:head"

        def Cube "head_shell" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.3, 0.32, 0.35)]
            float[] primvars:displayOpacity = [1]
            double size = 1
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:scale = (0.15, 0.10175, 0.10175)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            custom string yax:name = "head shell"
            custom double3 yax:pos = (0, 0, 0)
            custom double4 yax:quat = (1, 0, 0, 0)
            custom token yax:role = "collision"
            custom double[] yax:size = [0.15, 0.10175, 0.10175]
