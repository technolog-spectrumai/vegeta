    def Scope "joints"
    {
        def PhysicsRevoluteJoint "waist_yaw" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 20
            float drive:angular:physics:stiffness = 1
            uniform token physics:axis = "X"
            rel physics:body0 = </space_breacher/pelvis>
            rel physics:body1 = </space_breacher/torso>
            point3f physics:localPos0 = (0, 0, 0.085)
