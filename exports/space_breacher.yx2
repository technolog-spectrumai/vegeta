    def Xform "pelvis" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, 0.031685982)
        float3 physics:diagonalInertia = (0.15788886, 0.2948731, 0.3693316)
        float physics:mass = 21.757772
        quatf physics:principalAxes = (0.70710677, -5.37522e-15, -4.001174e-15, 0.70710677)
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        custom double3 yax:com = (0, 0, 0.03168598071838037)
        custom string yax:data = '{"free_joint":"pelvis:free"}'
        custom double[] yax:inertia = [0.2948730771961098, 7.856997111484594e-16, -9.84097063032199e-16, 7.856997111484594e-16, 0.15788886467185903, 4.2070044693749497e-16, -9.84097063032199e-16, 4.2070044693749497e-16, 0.3693315971973519]
        custom double yax:mass = 21.757772850000002
        custom string yax:name = "pelvis"
        custom double3 yax:pos = (0, 0, 0)
        custom double4 yax:quat = (1, 0, 0, 0)
        custom string yx2:id = "link:pelvis"

        def Cube "pelvis_shell" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
