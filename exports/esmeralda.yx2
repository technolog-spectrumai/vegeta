    custom string yax:data = "{\"ketos\":{\"card\":{\"autonomous\":true,\"autonomy\":{\"ais\":\"class A transponder: the others see it, it sees them\",\"boat_control\":\"Barracuda's MANET and UHF command link from the mast, its takeover and lost-link rendezvous\",\"colregs\":\"COLREGs rules 8-17 in the autopilot: give way / stand on, a closest-approach limit of 0.3 nm\",\"comms\":\"LEO satcom + 4G/LTE + UHF to shore; 900 MHz + LTE to the drones; ADS-B in\",\"gnss_ins\":\"dual RTK GNSS + fibre-optic INS: DP over the bed, the pads' motion for the drones\",\"guard\":\"the guard picture: radar, turret, ring cameras, AIS and the drones' tracks fused; contacts classified with the operator; the escalation ladder's interlocks (no step above a hail without a live operator)\",\"lidar_cameras\":\"360 deg lidar ring, day and IR cameras: small craft, buoys, swimmers, the drones on deck\",\"radar\":\"X- and S-band ARPA: targets out to 12 nm, the collision avoidance's tracks\",\"supervision\":\"one shore operator per 3 vessels: alarms, a remote takeover (teleop) when a fault asks\"},\"battery_kWh\":350.0,\"bay\":{\"bay_length_m\":14.0,\"bay_width_m\":3.6,\"boat_fits\":true,\"boat_mast\":\"folded in the bay: mast up it would hit the flight deck\",\"boat_mast_up_top_m\":6.77,\"boat_needs_m\":2.9,\"clear_height_over_cradle_m\":4.16,\"flight_deck_underside_m\":5.7,\"ramp_fits_tunnel\":true,\"tunnel_width_m\":4.4},\"boat\":{\"hs_limit_m\":1.95,\"launch_s\":90.0,\"mass_kg\":3475,\"name\":\"barracuda\",\"ramp\":{\"boat_bow_keel_z_m\":1.54,\"boat_transom_keel_z_m\":0.27,\"clear_height_m\":2.9,\"cycle\":{\"launch\":\"release the lashings 20 s, slack the winch and slide down the wet ramp 40 s, jets on and away 30 s\",\"recovery\":\"line up astern at 4 kn 60 s, drive into the ramp's mouth, the hook takes the bow eye 30 s, haul in 90 s, cradle, lash, refuel and shore power couple 60 s\"},\"haul_pull_kN\":8.1,\"hs_limit_m\":1.95,\"launch_s\":90.0,\"max_boat_kg\":6419,\"power_kW\":22.0,\"ramp_deg\":8.0,\"ramp_length_m\":13.5,\"ramp_width_m\":3.38,\"recovery_s\":240.0,\"refuel_l_min\":100.0,\"relative_motion_tolerance_m\":1.0,\"system\":\"stern ramp between the demihulls: a capture hook for the bow eye, a haul-in winch, a cradle with keel guides at its top\",\"system_mass_kg\":3559,\"system_price_eur\":260000.0,\"winch_kN\":15.0},\"recovery_s\":240.0,\"refuel_from_ship\":true},\"carries\":[\"barracuda\",\"gannet\",\"fulmar\"],\"changed_vs_zarco\":{\"chargers\":[12,5],\"davits\":[4,0],\"draught_m\":[1.39,1.363],\"endurance_days\":[15.6,21.2],\"gm_t_m\":[12.45,13.03],\"hangar\":[{\"fulmar\":3,\"gannet\":8},{\"fulmar\":2,\"gannet\":4}],\"mass_t\":[96.75,94.01],\"price_eur\":[4153780,4830720],\"station_load_kW\":[82.0,60.2],\"trim_deg\":[0.0,-0.3],\"unchanged\":\"hulls, propulsion (service 10 kn, max 14.6 kn), autonomy mast, flight deck (4 pads, catapult, net), deck closure Hs 2.0 m\"},\"class_values\":true,\"crew\":0,\"day_rate_eur\":1400.0,\"displacement_t\":108.0,\"draught_m\":1.36,\"effectors\":{\"flare_launcher\":{\"fitted\":false,\"space_reserved\":\"a 0.5 x 0.5 m foundation on the mast house roof, 60 kg\",\"why_not\":\"pyrotechnics from a civilian unmanned vessel: distress signals are reserved (COLREGs Annex IV); illuminating or warning flares near a craft are a rules-of-engagement question for the flag state and the platform's operator - not assumed. Non-pyrotechnic alternative: self-locating datum marker buoys (a light and an AIS/GNSS beacon) dropped to mark a contact's track - also not fitted until agreed.\"},\"hailer\":{\"audible_m\":3036,\"intelligible_m\":{\"quiet_deck\":2283,\"skiff_at_speed\":368,\"skiff_idling\":1283},\"mass_t\":0.1,\"power_kW\":1.0,\"price_eur\":90000.0,\"spl_1m_db\":160.0,\"what\":\"long-range acoustic hailer, 160 dB class at 1 m, 15 deg beam at 2 kHz, on the mast's pan-tilt\"},\"searchlights\":{\"beam_deg\":2.5,\"count\":2,\"haze_range_m\":1831,\"lumens\":35000.0,\"mass_t\":0.12,\"peak_cd\":14044681,\"power_kW\":1.6,\"price_