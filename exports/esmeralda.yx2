or a cargo crate into a Gannet's hook or a Fulmar's bay\"},\"deck_tug\":{\"count\":1,\"cycle_s\":60.0,\"faults_per_day\":0.1,\"fix_min\":10.0,\"payload_kg\":30.0,\"power_kW\":0.8,\"price_eur\":45000.0,\"reach_m\":14.0,\"what\":\"a low tug with a gripper: drones between the pads, the lift and the catapult cradle; a Fulmar out of the net\"},\"swap_robot\":{\"count\":1,\"cycle_s\":90.0,\"faults_per_day\":0.3,\"fix_min\":8.0,\"payload_kg\":8.0,\"power_kW\":1.0,\"price_eur\":90000.0,\"reach_m\":12.0,\"what\":\"a gantry between the pads and the battery room: the pack out of a locked drone's sled, a charged one in\"}},\"role\":\"guard carrier\",\"schema\":\"ketos.card\",\"sea_state_limits\":{\"boat_ramp_hs_m\":1.95,\"deck_hs_m\":2.0},\"sensors\":{\"ais_km\":{\"class_a\":28.7,\"class_b\":15.0},\"camera_ring\":{\"dri_skiff_km\":{\"day_clear\":{\"detection\":4.91,\"identification\":0.77,\"recognition\":1.23},\"day_fog\":{\"detection\":0.47,\"identification\":0.17,\"recognition\":0.23},\"day_haze\":{\"detection\":3.46,\"identification\":0.77,\"recognition\":1.23},\"night_clear\":{\"detection\":0.82,\"identification\":0.13,\"recognition\":0.2},\"night_fog\":{\"detection\":0.47,\"identification\":0.13,\"recognition\":0.2},\"night_haze\":{\"detection\":0.82,\"identification\":0.13,\"recognition\":0.2}},\"what\":\"Zarco's ring of day 4K and uncooled LWIR 640 cameras, 60 deg each (kept)\"},\"lidar_m\":{\"note\":\"the 360 deg lidar ring's class ranges (assumed)\",\"skiff\":200,\"swimmer\":60},\"radars\":{\"S\":{\"antenna_m\":8.5,\"fishing_km_by_hs\":{\"0.5\":20.3,\"1.0\":18.1,\"2.0\":13.9,\"2.5\":11.7},\"ref_range_km\":12.0,\"ref_rcs_m2\":10.0,\"skiff_km_by_hs\":{\"0.5\":6.4,\"1.0\":5.7,\"2.0\":4.4,\"2.5\":3.7},\"what\":\"S-band ARPA: through rain and heavy clutter, ships at range\"},\"X\":{\"antenna_m\":8.5,\"fishing_km_by_hs\":{\"0.5\":22.1,\"1.0\":21.2,\"2.0\":16.2,\"2.5\":13.7},\"ref_range_km\":14.0,\"ref_rcs_m2\":10.0,\"skiff_km_by_hs\":{\"0.5\":7.5,\"1.0\":6.7,\"2.0\":5.1,\"2.