    def Scope "joints"
    {
        def PhysicsRevoluteJoint "waist_yaw" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 30
            float drive:angular:physics:stiffness = 1
            uniform token physics:axis = "X"
            rel physics:body0 = </space_heavy/pelvis>
            rel physics:body1 = </space_heavy/torso>
            point3f physics:localPos0 = (0, 0, 0.085)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, -0.70710677, 0)
            quatf physics:localRot1 = (0.70710677, 0, -0.70710677, 0)
            float physics:lowerLimit = -68.75494
            float physics:upperLimit = 68.75494
            custom double3 yax:axis = (0, 0, 1)
            custom string yax:data = "{\"motor\":{\"control\":{\"four_quadrant\":false,\"kd\":30.0,\"kp\":3000.0,\"law\":\"PD clipped to the torque\\u2013speed line\"},\"derived_from\":\"cycloidal 800 Nm, brake\",\"kind\":\"servo model\",\"kt_nm_per_a\":4.444444444444445,\"no_load_speed_rad_s\":4.1887902047863905,\"rated_torque_nm\":300.0,\"resistance_ohm\":0.26666666666666666,\"source\":\"cycloidal 800 Nm, brake: assumed: 48 V BLDC with a 1:60 cycloidal stage and a holding brake, light-industrial joint-module class; kt and resistance are the servo model's estimates from the stall point (kt = \\u03c4_stall / I_stall, R = V / I_stall)\",\"stall_current_a\":180.0,\"stall_torque_nm\":800.0,\"voltage_v\":48.0}}"
            custom string yax:drive = '{"damping":30.0,"stiffness":1.0}'
            custom token yax:kind = "revolute"
            custom double2 yax:limits = (-1.2, 1.2)
            custom string yax:name = "waist_yaw"
            custom double3 yax:pos = (0, 0, 0.085)
            custom string yx2:id = "joint:waist_yaw"
        }

        def PhysicsRevoluteJoint "L_shoulder_pitch" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 6
            float drive:angular:physics:stiffness = 1
            uniform token physics:axis = "X"
            rel physics:body0 = </space_heavy/torso>
            rel physics:body1 = </space_heavy/L_upper_arm__L_shoulder_pitch>
            point3f physics:localPos0 = (0, 0.37, 0.468)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
            quatf physics:localRot1 = (0.70710677, 0, 0, 0.70710677)
            float physics:lowerLimit = -171.88734
            float physics:upperLimit = 57.29578
            custom double3 yax:axis = (0, 1, 0)
            custom string yax:data = "{\"motor\":{\"control\":{\"four_quadrant\":false,\"kd\":6.0,\"kp\":400.0,\"law\":\"PD clipped to the torque\\u2013speed line\"},\"derived_from\":\"harmonic 150 Nm, brake\",\"kind\":\"servo model\",\"kt_nm_per_a\":5.0,\"no_load_speed_rad_s\":3.1415926535897927,\"rated_torque_nm\":60.0,\"resistance_ohm\":1.6,\"source\":\"harmonic 150 Nm, brake: assumed: 48 V BLDC with a 1:120 strain-wave gear and a holding brake, cobot elbow-joint class; kt and resistance are the servo model's estimates from the stall point (kt = \\u03c4_stall / I_stall, R = V / I_stall)\",\"stall_current_a\":30.0,\"stall_torque_nm\":150.0,\"voltage_v\":48.0}}"
            custom string yax:drive = '{"damping":6.0,"stiffness":1.0}'
