    def Xform "hull" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0.1566572, 0, 0.006250906)
        float3 physics:diagonalInertia = (24.598713, 93.51707, 94.22324)
