    def Scope "joints"
    {
        def PhysicsRevoluteJoint "FL_shoulder" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 120
            float drive:angular:physics:stiffness = 1
            uniform token physics:axis = "X"
            rel physics:body0 = </onager/hull>
            rel physics:body1 = </onager/FL_upper_leg>
            point3f physics:localPos0 = (0.9, 0.506, -0.031925615)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
            quatf physics:localRot1 = (0.70710677, 0, 0, 0.70710677)
            float physics:lowerLimit = -20
            float physics:upperLimit = 100
            custom double3 yax:axis = (0, 1, 0)
            custom string yax:data = "{\"motor\":{\"control\":{\"four_quadrant\":false,\"kd\":120.0,\"kp\":1600.0,\"law\":\"PD clipped to the torque\\u2013speed line\"},\"derived_from\":\"cycloidal 800 Nm, brake\",\"kind\":\"servo model\",\"kt_nm_per_a\":4.444444444444445,\"no_load_speed_rad_s\":4.1887902047863905,\"rated_torque_nm\":300.0,\"resistance_ohm\":0.26666666666666666,\"source\":\"cycloidal 800 Nm, brake: assumed: 48 V BLDC with a 1:60 cycloidal stage and a holding brake, light-industrial joint-module class; kt and resistance are the servo model's estimates from the stall point (kt = \\u03c4_stall / I_stall, R = V / I_stall)\",\"stall_current_a\":180.0,\"stall_torque_nm\":800.0,\"transmission\":{\"reflected_inertia_kgm2\":0.05,\"source\":\"the servo model's armature (rotor inertia \\u00d7 gear ratio\\u00b2)\"},\"voltage_v\":48.0}}"
