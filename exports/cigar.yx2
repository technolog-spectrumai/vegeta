    custom string yax:data = "{\"ketos\":{\"card\":{\"accel_0_cruise_s\":52.0,\"airborne\":true,\"ais\":false,\"ais_typical\":false,\"basis\":\"sized as a light-to-midsize business jet or a fast jet drone: 15-20 m long, MTOW ~8.5 t; Mach 0.6-0.8 (215 m/s low, 245 m/s high); a minimum speed of ~70 m/s (its stall, clean); load factor 2.5 at low level (transport-category limit), 1.5 sustainable near its ceiling; roll ~90 deg/s; climb ~25 m/s; thrust/weight ~0.35 (accelerating ~2.5 m/s2 at low speed). RCS of a bizjet (~1 m2 nose-on, ~10 beam); IR of a small turbofan's nozzle (~700 K). The winged spindle and its flight are fiction.\",\"behaviour\":\"moves like a jet: never below 70 m/s, turns by banking (2.5 g low); low passes at 200 m/s, transits high out of gun range; appears late in a mission\",\"bounding_radius_m\":9.47,\"class_values\":true,\"collision\":[{\"axis\":[1,0,0],\"name\":\"body\",\"pos\":[0.0,0.0,0.0],\"size\":[1.0,8.0],\"type\":\"capsule\"},{\"axis\":[1,0,0],\"name\":\"tail\",\"pos\":[-8.0,0.0,0.0],\"size\":[0.8,1.05],\"type\":\"cylinder\"},{\"name\":\"fin\",\"pos\":[-6.3,0.0,1.85],\"size\":[1.7,0.07,1.1],\"type\":\"box\"},{\"name\":\"wing_port\",\"pos\":[-3.489,2.45,-0.2],\"quat\":[0.429975,0.0,0.0,0.902841],\"size\":[3.662,1.734,0.125],\"type\":\"box\"},{\"name\":\"wing_starboard\",\"pos\":[-3.489,-2.45,-0.2],\"quat\":[0.429975,0.0,0.0,-0.902841],\"size\":[3.662,1.734,0.125],\"type\":\"box\"}],\"crew\":[1,3],\"cruise_kn\":388.8,\"cruise_m_s\":200.0,\"fictional\":true,\"flag\":{\"faces\":\"both\",\"offset_m\":0.07500000000000001,\"origin\":[-5.6,0.0,1.2],\"size\":[1.5,1.0],\"texture\":\"alien_jolly_roger.png\",\"u\":[-1.0,0.0,0.0],\"v\":[0.0,0.0,1.0],\"where\":\"painted on both sides of the dorsal fin\"},\"flak\":{\"guns\":{\"aa_35\":{\"mean_m_s\":900.0,\"muzzle_m_s\":1175.0,\"range_m\":4000.0,\"rate_rpm\":1100,\"what\":\"a twin 35 mm anti-aircraft gun\"},\"ciws_30\":{\"mean_m_s\":850.0,\"muzzle_m_s\":1080.0,\"range_m\":2500.0,\"rate_rpm\":600,\"what\":