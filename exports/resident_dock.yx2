    custom string yax:data = "{\"ketos\":{\"card\":{\"charge_W\":2000.0,\"clearance_m\":8.95,\"comms\":\"fibre\",\"depth_m\":80.0,\"docking\":{\"cross_current_limit_m_s\":0.42,\"cycle_s\":{\"back in along the guide lights at 0.15 m/s (the garage's 3 m and the last 7 m)\":67,\"home on the dock's USBL to 30 m off the mouth\":0,\"hover and line up 10 m off, tail to the mouth, into the current\":60,\"latch, seat on the coupler, optical link up\":30},\"dock_s\":157,\"head_current_limit_m_s\":1.0,\"note\":\"the mouth faces out from the jacket; a rotating tidal current crosses it twice a tide - docking waits for the cross component under the limit (North Sea tides at 80 m: ~0.3-0.6 m/s, assumed)\",\"orbital_at_depth_m_s\":{\"-30m\":0.47,\"-50m\":0.21,\"-65m\":0.11,\"-80m\":0.06},\"undock_s\":23},\"fitting_depths_m\":{\"A1\":[-30.0,-40.0,-45.0,-55.0,-60.0,-70.0,-75.0,-80.0],\"A2\":[],\"B1\":[-30.0,-40.0,-45.0,-55.0,-60.0,-70.0,-75.0,-80.0],\"B2\":[-30.0,-40.0,-45.0,-55.0,-60.0,-70.0,-75.0,-80.0]},\"kind\":\"dock\",\"leg\":\"A1\",\"legs_that_fit_at_depth\":[\"A1\",\"B1\",\"B2\"],\"mass_kg\":1800.0,\"mount\":{\"bolt\":\"M30 10.9, 280 kN preload (class)\",\"bolts_per_collar\":4,\"collar_height_m\":0.45,\"collar_mass_kg\":1644,\"collar_spacing_m\":1.5,\"collar_wall_m\":0.03,\"collars\":2,\"cp\":\"bonded to the jacket's cathodic protection through the collars' bonding straps, plus two anodes on the garage\",\"drag_kN\":3.2,\"install\":\"two halves lowered from the DP vessel and closed round the leg by a work-class ROV (Homarus), studs tensioned hydraulically after the leg is cleaned of growth under the liner; the garage on a bracket that takes out the leg's 1:10 batter so it lies level\",\"leg_d_m\":2.0,\"lever_m\":3.25,\"liner_bore_m\":2.024,\"mu\":0.2,\"no_welding\":true,\"normal_force_per_collar_kN\":418,\"safety_factor\":2.0,\"weight_in_water_kN\":15.4},\"mount_mass_kg\":1644,\"name\":\"resident_dock\",\"parts\":[{\"color\":[0.086,0.627,0.522],\"model\":\"resident_dock_frame\"}],\"price_eur\":900000.0,\"schema\":\"ketos.card\",\"services\":{\"cable\":{\"length_m\":160,\"loss_W\":39,\"power\":\"400 V DC from the topside, 2.5 kW\",\"what\":\"armoured hybrid cable up the leg in clamps: 2 single-mode fibres + 2 x 6 mm2 copper\"},\"charger\":{\"charge_h\":2.2,\"efficiency\":0.9,\"kW\":2.0,\"kind\":\"inductive coupler at the garage's back (no wet-mate pins)\",\"squilla_battery_Wh\":4500.0,\"usable_Wh\":3825},\"data\":{\"away\":\"acoustic modem + USBL head on the dock: ~5-10 kbit/s to ~2 km, Squilla's position for the carrier and the topside\",\"docked\":\"optical free-space modem at the coupler, ~100 Mbit/s over ~1 m: video and logs off, mission plans on\",\"latency\":\"fibre: ms; acoustic: ~1.5 s a km\",\"topside\":\"1 Gbit/s Ethernet over fibre\"},\"patrol\":{\"duty_out_of_dock\":0.87,\"hours_on_a_charge\":16.2,\"note\":\"a guard patrol at ~1 m/s round the jacket; intervention work (s['work_W']) empties it ~3x faster\",\"power_W\":236},\"work_W\":650},\"size\":[3.0,1.6,1.4],\"version\":\"1.0\"},\"meshes\":[\"resident_dock_frame\"],\"source\":\"exports/ketos/resident_dock.card.json\"},\"provenance\":{\"notes\":\"Squilla's garage on a leg of the jacket: a rigid body (fixed to the leg)\",\"robot\":\"ResidentDock\",\"sources\":{\"looks\":\"designs/oil_platform.py:ResidentDock\",\"mass\":\"oil_platform.ResidentDock (class value)\"}}}"
