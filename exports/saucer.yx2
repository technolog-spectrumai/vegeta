    custom string yax:data = "{\"ketos\":{\"card\":{\"accel_0_cruise_s\":22.7,\"airborne\":true,\"ais\":false,\"ais_typical\":false,\"basis\":\"sized as a medium twin helicopter of a 13-14 m rotor (the AW139 / Bell 412 class): MTOW ~6.4 t; max speed ~78 m/s (150 kn) and cruise ~68 m/s (130 kn); sideward and rearward flight limits 35 and 30 kn; climb ~10 m/s; a hover yaw rate of ~40 deg/s; 45 deg bank, 20 deg pitch in manoeuvres; accelerating at ~0.3 g (nose ~17 deg down), flaring at ~0.4 g. RCS of a helicopter that size (a few m2 nose-on); IR of its exhausts (~500 K) put at the belly. The disc, dome and its flight are fiction.\",\"behaviour\":\"moves like a helicopter: hovers, creeps sideways and backwards, turns on the spot; patrols low and slow, dashes at 78 m/s; appears late in a mission\",\"bounding_radius_m\":6.71,\"class_values\":true,\"collision\":[{\"name\":\"disc\",\"pos\":[0.0,0.0,1.15],\"size\":[6.0,6.0,0.75],\"type\":\"ellipsoid\"},{\"name\":\"dome\",\"pos\":[0.0,0.0,1.9],\"size\":[2.3,2.3,1.5],\"type\":\"ellipsoid\"},{\"axis\":[0,0,1],\"name\":\"mast\",\"pos\":[0.0,0.0,4.7],\"size\":[0.06,1.3],\"type\":\"capsule\"},{\"axis\":[0,0,1],\"name\":\"pad_0\",\"pos\":[0.0,3.6,0.2],\"size\":[0.35,0.2],\"type\":\"cylinder\"},{\"axis\":[0,0,1],\"name\":\"pad_1\",\"pos\":[-3.118,-1.8,0.2],\"size\":[0.35,0.2],\"type\":\"cylinder\"},{\"axis\":[0,0,1],\"name\":\"pad_2\",\"pos\":[3.118,-1.8,0.2],\"size\":[0.35,0.2],\"type\":\"cylinder\"}],\"crew\":[2,4],\"cruise_kn\":132.2,\"cruise_m_s\":68.0,\"fictional\":true,\"flag\":{\"faces\":\"both\",\"origin\":[-0.06,0.0,4.95],\"size\":[1.5,1.0],\"texture\":\"alien_jolly_roger.png\",\"u\":[-1.0,0.0,0.0],\"v\":[0.0,0.0,1.0],\"where\":\"on the mast atop the dome, flying aft\"},\"flak\":{\"guns\":{\"aa_35\":{\"mean_m_s\":900.0,\"muzzle_m_s\":1175.0,\"range_m\":4000.0,\"rate_rpm\":1100,\"what\":\"a twin 35 mm anti-aircraft gun\"},\"ciws_30\":{\"mean_m_s\":850.0,\"muzzle_m_s\":1080.0,\"range_m\":2500.0,\"rate_rpm\":600,\"what\":\"a 3