 "kpis": [
  {
   "key": "rate10",
   "group": "bandit",
   "label": "turn rate at 10 m/s [deg/s]",
   "better": "high",
   "why": "staying inside a slow bandit's turn"
  },
  {
   "key": "rate15",
   "group": "bandit",
   "label": "turn rate at 15 m/s [deg/s]",
   "better": "high",
   "why": "the bandit's middle speed"
  },
  {
   "key": "rate25",
   "group": "bandit",
   "label": "turn rate at 25 m/s [deg/s]",
   "better": "high",
   "why": "turning while catching up"
  },
  {
   "key": "reverse",
   "group": "bandit",
   "label": "reverse direction at 15 m/s [s]",
   "better": "low",
   "why": "the bandit reverses"
  },
  {
   "key": "stop",
   "group": "bandit",
   "label": "stop from 25 m/s [m]",
   "better": "low",
   "why": "the bandit stops; 'cannot' = it overshoots"
  },
  {
   "key": "accel",
   "group": "bandit",
   "label": "level acceleration at 15 m/s [g]",
   "better": "high",
   "why": "closing a gap that opened"
  },
  {
   "key": "climb",
   "group": "bandit",
   "label": "ground to 150 m [s]",
   "better": "low",
   "why": "the bandit climbs away"
  },
  {
   "key": "band",
   "group": "bandit",
   "label": "bandit speeds it can match, 0-20 m/s [%]",
   "better": "high",
   "why": "flying beside it, hovering included"
  },
  {
   "key": "repass",
   "group": "bandit",
   "label": "back on a hovering bandit after a pass [s]",
   "better": "low",
   "why": "0 = it never has to leave"
  },
  {
   "key": "top",
   "group": "general",
   "label": "top speed [m/s]",
   "better": "high",
   "why": "reaching the place"
  },
  {
   "key": "cruise",
   "group": "general",
   "label": "cruise endurance [min]",
   "better": "high",
   "why": "time on station on the wing"
  },
  {
   "key": "range",
   "group": "general",
   "label": "still-air range [km]",
   "better": "high",
   "why": "cruise endurance x its speed"
  },
  {
   "key": "hover",
   "group": "general",
   "label": "hover endurance [min]",
   "better": "high",
   "why": "'cannot' = it does not hover"
  },
  {
   "key": "whkm",
   "group": "general",
   "label": "energy per kilometre [Wh/km]",
   "better": "low",
   "why": "what a trip costs"
  },
  {
   "key": "span",
   "group": "general",
   "label": "width in flight [m]",
   "better": "low",
   "why": "gaps, transport, the 4 m alley"
  }
 ],
