#usda 1.0
(
    customLayerData = {
        dictionary yx2 = {
            dictionary frame = {
                string forward = "+x"
                string handed = "right"
                string pose = "machine frame at q = 0"
                string up = "+z"
            }
            dictionary units = {
                string angle = "rad"
                string length = "m"
                string mass = "kg"
                string time = "s"
            }
            string version = "0.1"
        }
    }
    defaultPrim = "vespula"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

