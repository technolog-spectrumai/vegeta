/*--------------------------------*- C++ -*----------------------------------*\
  Aeromant template case (OpenFOAM.org dialect) — placeholder values are inserted by aeromant.prepare()
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    ground
    {
        type            zeroGradient;
    }
    floor
    {
        type            zeroGradient;
    }
    suction
    {
        type            zeroGradient;
    }
    sides
    {
        type            fixedValue;
        value           uniform 0;
    }
    "body.*"
    {
        type            zeroGradient;
    }
}

// ************************************************************************* //
